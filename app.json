{
  "expo": {
    "name": "ExpoBrew",
    "slug": "ExpoBrew",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/coffee-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/coffee-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.klerd.expobrew"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/coffee-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.klerd.expobrew"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "d6eb39b3-58cf-4faa-9803-c9c728a29948"
      }
    }
  }
}
